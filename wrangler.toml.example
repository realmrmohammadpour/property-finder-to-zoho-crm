# Public example only; all identifiers below are placeholders.
name = "pf-zoho-reference"
main = "src/index.js"
compatibility_date = "2026-10-01"

[triggers]
crons = ["*/5 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "REPLACE_WITH_YOUR_D1_NAME"
database_id = "00000000-0000-0000-0000-000000000000"

[vars]
ZOHO_EXTERNAL_ID_FIELD = "External_Lead_ID"
ZOHO_COMPANY_LABEL = "Inbound Inquiry"
# Configure the appropriate Zoho region for your account.
# ZOHO_ACCOUNTS_URL = "https://accounts.zoho.com"
# ZOHO_API_DOMAIN = "https://www.zohoapis.com"
